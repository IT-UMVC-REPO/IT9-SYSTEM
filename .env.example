APP_NAME=LocalPalengke
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=localpalengke
DB_USERNAME=root
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
SMTP2GO_API_KEY=
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=auto
AWS_BUCKET=
AWS_URL=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

FILESYSTEM_DISK=public
FILESYSTEM_PUBLIC_DRIVER=local
FILESYSTEM_PUBLIC_URL=
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

# Broadcasting — Ably Pusher-compatible adapter
# Sign up free at ably.com. API key format: appId.keyId:keySecret
# PUSHER_APP_ID = everything before the first dot
# PUSHER_APP_KEY = everything before the colon (appId.keyId)
# PUSHER_APP_SECRET = everything after the colon
BROADCAST_CONNECTION=pusher
PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=
PUSHER_HOST=rest-pusher.ably.io
PUSHER_PORT=443
PUSHER_SCHEME=https

VITE_REVERB_APP_KEY="${PUSHER_APP_KEY}"
VITE_REVERB_HOST=realtime-pusher.ably.io
VITE_REVERB_PORT=443
VITE_REVERB_SCHEME=https

WEBRTC_STUN_URLS=stun:stun.cloudflare.com:3478,stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302,stun:stun2.l.google.com:19302

# WebRTC TURN is required for reliable mobile-to-mobile calls across different networks.
# Example: turn:turn.example.com:3478?transport=udp,turns:turn.example.com:5349?transport=tcp
WEBRTC_TURN_URLS=
# Static TURN username/password from your TURN provider.
WEBRTC_TURN_USERNAME=
WEBRTC_TURN_CREDENTIAL=
# Alternative: shared-secret TURN auth. If set, this is preferred over static credentials.
WEBRTC_TURN_SHARED_SECRET=
WEBRTC_TURN_TTL=3600
# Use "relay" to force TURN-only media paths while debugging mobile/NAT issues.
WEBRTC_ICE_TRANSPORT_POLICY=all

TELESCOPE_ALLOWED_EMAILS=

VITE_APP_NAME="${APP_NAME}"
